{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "package-dist/lib",
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "customConditions": [],
    "jsx": "react-jsx",
    "declaration": true,
    "sourceMap": true,
    "noEmit": false,
    "esModuleInterop": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", ".rnstorybook"]
}
